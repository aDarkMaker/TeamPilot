---
import { ClientRouter, fade } from 'astro:transitions';
import '@/styles/layouts/dashboard.css';
import '@/styles/components/dashboard-toast.css';
import '@/styles/base/global.css';
import '@/styles/base/animations.css';
import '@/styles/components/search-panel.css';
import '@/styles/base/tangerine-fonts.css';
import '@/styles/base/tangerine/tokens.css';
import '@/styles/base/tangerine/utilities.css';
import '@/styles/base/tangerine/controls.css';
import '@/styles/base/tangerine/choices.css';
import '@/styles/base/tangerine/surfaces.css';
import '@/styles/base/tangerine/feedback.css';
import '@/styles/base/tangerine/scaffold.css';
import { assetUrl } from '@/lib/assetUrl';
import favicon from '@/assets/img/icon/icon-hxk.webp';
import fontBody from '@/assets/fonts/tangerine/inter-var.woff2';
import fontDisplay from '@/assets/fonts/tangerine/bricolage-grotesque-700.woff2';
import fontCjk from '@/assets/fonts/tangerine/misans-sc-var.woff2';
import DashboardSidebar from '@/components/dashboard/shell/DashboardSidebar';
import DashboardTopBar from '@/components/dashboard/shell/DashboardTopBar';
import DashboardBackground from '@/components/dashboard/shell/DashboardBackground';
import DashboardAuthGuard from '@/components/dashboard/shell/DashboardAuthGuard';
import UserNameWatermark from '@/components/dashboard/shell/UserNameWatermark';

interface Props {
    title?: string;
    notifyVariant?: 'new' | 'mention' | 'read';
}

const { title = '工作主页', notifyVariant = 'read' }: Props = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="dashboard-shell" transition:name="dash-html" transition:animate="none">
    <head>
        <ClientRouter />
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests" />

        <link rel="icon" type="image/png" href={assetUrl(favicon)} />
        <link rel="preload" href={assetUrl(fontBody)} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={assetUrl(fontDisplay)} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={assetUrl(fontCjk)} as="font" type="font/woff2" crossorigin />
        <link rel="preconnect" href="https://upos-sz-mirrorcos.bilivideo.com" />
        <link rel="preconnect" href="https://i0.hdslb.com" />
        <title>{title} · HXK</title>
        <script>
            document.addEventListener('astro:before-swap', (e) => {
                document.documentElement.classList.add('dash-is-transitioning');
                const bg = localStorage.getItem('hxk_profile_background_url');
                if (bg) {
                    e.newDocument.documentElement.style.setProperty('--dash-bg-image', `url(${bg})`);
                }
            });
            document.addEventListener('astro:after-swap', () => {
                document.documentElement.classList.remove('dash-is-transitioning');
            });
        </script>
    </head>
    <body>
        <div class="dashboard-root">
            <DashboardAuthGuard client:load />
            <DashboardSidebar
                client:load
                transition:persist="dashboard-sidebar"
                transition:animate="none"
                initialPath={Astro.url.pathname}
            />
            <DashboardBackground client:load transition:persist="dashboard-bg" transition:animate="none" />
            <div class="dashboard-main">
                <UserNameWatermark client:load transition:persist="dashboard-watermark" transition:animate="none" />
                <DashboardTopBar client:load transition:persist="dashboard-topbar" transition:animate="none" title={title} notifyVariant={notifyVariant} />
                <main class="content-wrapper" transition:animate={fade({ duration: '0.12s' })}>
                    <slot />
                </main>
            </div>
        </div>
    </body>
</html>