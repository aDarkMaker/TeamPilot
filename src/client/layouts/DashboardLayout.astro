---
import { ClientRouter, fade } from 'astro:transitions';
import '../styles/dashboard.css';
import '../styles/dashboard-toast.css';
import '../styles/users-admin.css';
import '../styles/joinus-form-admin.css';
import '../styles/calendar.css';
import '../styles/global.css';
import '../styles/search-panel.css';
import { assetUrl } from '../lib/assetUrl';
import favicon from '../assets/img/icon/icon-hxk.webp';
import fontHxk from '../assets/fonts/fonts.ttf';
import DashboardSidebar from '../components/dashboard/DashboardSidebar';
import DashboardTopBar from '../components/dashboard/DashboardTopBar';
import DashboardBackground from '../components/dashboard/DashboardBackground';
import DashboardAuthGuard from '../components/dashboard/DashboardAuthGuard';

interface Props {
    title?: string;
    notifyVariant?: 'new' | 'mention' | 'read';
}

const { title = '工作主页', notifyVariant = 'read' }: Props = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="dashboard-shell" transition:name="dash-html" transition:animate="none">
    <head>
        <ClientRouter />
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href={assetUrl(favicon)} />
        <link rel="preload" href={assetUrl(fontHxk)} as="font" type="font/ttf" crossorigin />
        <link rel="preconnect" href="https://upos-sz-mirrorcos.bilivideo.com" />
        <link rel="preconnect" href="https://i0.hdslb.com" />
        <title>{title} · HXK</title>
        <script>
            document.addEventListener('astro:before-swap', (e) => {
                const bg = localStorage.getItem('hxk_profile_background_url');
                if (bg) {
                    e.newDocument.documentElement.style.setProperty('--dash-bg-image', `url(${bg})`);
                }
            });
        </script>
    </head>
    <body>
        <div class="dashboard-root">
            <DashboardAuthGuard client:load />
            <DashboardSidebar
                client:load
                transition:persist="dashboard-sidebar"
                initialPath={Astro.url.pathname}
            />
            <DashboardBackground client:load transition:persist="dashboard-bg" />
            <div class="dashboard-main">
                <DashboardTopBar client:load transition:persist="dashboard-topbar" title={title} notifyVariant={notifyVariant} />
                <main class="content-wrapper" transition:animate={fade({ duration: '0.22s' })}>
                    <slot />
                </main>
            </div>
        </div>
    </body>
</html>