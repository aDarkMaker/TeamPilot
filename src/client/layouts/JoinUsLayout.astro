---
import '../styles/global.css';
import '../styles/joinus.css';
import '../styles/joinus-transitions.css';
import '../styles/remixicon-local.css';
import '../styles/shapegrid.css';
import { assetUrl } from '../lib/assetUrl';
import favicon from '../assets/img/icon/icon-hxk.webp';
import joinusIcon from '../assets/img/icon/joinus/joinus.webp';
import hxkFontWoff2 from '../assets/fonts/fonts.woff2';
import joinusFontWoff2 from '../assets/fonts/joinusTitle.woff2';
import remixiconWoff2 from '../assets/fonts/remixicon.woff2';
import ShapeGrid from '../components/ShapeGrid';

interface Props {
	title: string;
	description?: string;
	skipHref: string;
	skipLabel: string;
}

const { title, description, skipHref, skipLabel } = Astro.props;
---

<html lang="zh-CN" class="joinus-page">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/webp" href={assetUrl(favicon)} />
		<link rel="preload" href={assetUrl(hxkFontWoff2)} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={assetUrl(joinusFontWoff2)} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={assetUrl(remixiconWoff2)} as="font" type="font/woff2" crossorigin />
		{description && <meta name="description" content={description} />}
		<title>{title}</title>
	</head>
	<body class="joinus-body">
		<ShapeGrid client:load />
		<div class="joinus-root">
			<a class="joinus-skip" href={skipHref}>{skipLabel}</a>
			<header class="joinus-header">
				<div class="joinus-header__inner">
					<a class="joinus-brand" href="/joinus">
						<img
							class="joinus-brand-icon"
							src={assetUrl(joinusIcon)}
							width="36"
							height="36"
							alt=""
							aria-hidden="true"
							fetchpriority="high"
							loading="eager"
						/>
						华小科招新
					</a>
					<div class="joinus-header-actions">
						<slot name="header-actions" />
					</div>
				</div>
			</header>
			<div class="joinus-page-transition">
				<slot />
			</div>
		</div>
	</body>
</html>