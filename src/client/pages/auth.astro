---
import '../styles/auth.css';
import '../styles/global.css';
import { assetUrl } from '../lib/assetUrl';
import favicon from '../assets/img/icon/icon-hxk.webp';
import fontHxk from '../assets/fonts/fonts.ttf';
import AuthTabs from '../components/auth/AuthTabs';
---

<html lang="zh-CN">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/webp" href={assetUrl(favicon)} />
        <link rel="preload" href={assetUrl(fontHxk)} as="font" type="font/truetype" crossorigin />
    </head>
    <body class="auth-page">
        <main class="auth-container">
            <AuthTabs client:load />
        </main>
    </body>
</html>
